#!/usr/bin/env python3
"""Dump a chapter's chunks from a book's corpus.sqlite as readable Markdown.

Usage:
    scripts/read-chapter 1                       # writes data/books/dzl/readable/ch01.md
    scripts/read-chapter 1 --print               # also prints to stdout
    scripts/read-chapter 1 --book-id dzl         # pick the book (default: dzl)
    scripts/read-chapter 1 -o /tmp/foo.md        # custom output path

Paths default to the per-book layout `data/books/<book_id>/{corpus.sqlite,readable/}`
(`--db` / `-o` override). The output is one chunk per section, with chunk_id +
paragraph range as a heading. Useful when hand-annotating golden YAML — keep this
file open in one editor pane and the YAML files in another.
"""

from __future__ import annotations

import argparse
import sqlite3
import sys
from pathlib import Path


def render_chapter(db_path: Path, chapter: int) -> str:
    if not db_path.exists():
        raise SystemExit(f"corpus db not found: {db_path}")
    conn = sqlite3.connect(db_path)
    rows = conn.execute(
        """
        SELECT c.id, c.paragraph_start, c.paragraph_end, c.text, d.chapter_title
        FROM chunks c
        JOIN documents d ON c.document_id = d.id
        WHERE d.chapter_num = ?
        ORDER BY c.paragraph_start
        """,
        (chapter,),
    ).fetchall()
    if not rows:
        raise SystemExit(f"no chunks found for chapter {chapter} in {db_path}")

    title = rows[0][4]
    lines: list[str] = [
        f"# Chapter {chapter} — {title}",
        "",
        f"**Source:** `{db_path}` &middot; **Chunks:** {len(rows)}",
        "",
        "---",
        "",
    ]
    for chunk_id, ps, pe, text, _ in rows:
        lines.append(f"## `{chunk_id}` &middot; paragraphs {ps}-{pe}")
        lines.append("")
        lines.append("```text")
        lines.append(text.rstrip("\n"))
        lines.append("```")
        lines.append("")
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description="Dump a chapter's chunks as Markdown.")
    parser.add_argument("chapter", type=int, help="chapter number (e.g., 1)")
    parser.add_argument(
        "--book-id",
        default="dzl",
        help="book id under data/books/ (default: dzl); sets the default db + output dir",
    )
    parser.add_argument(
        "--db",
        type=Path,
        default=None,
        help="path to corpus.sqlite (default: data/books/<book-id>/corpus.sqlite)",
    )
    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        default=None,
        help="output markdown path (default: data/books/<book-id>/readable/ch<NN>.md)",
    )
    parser.add_argument(
        "--print",
        dest="also_print",
        action="store_true",
        help="also print to stdout",
    )
    args = parser.parse_args()

    book_root = Path("data/books") / args.book_id
    db_path = args.db or book_root / "corpus.sqlite"
    md = render_chapter(db_path, args.chapter)
    out_path = args.output or book_root / "readable" / f"ch{args.chapter:02d}.md"
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(md, encoding="utf-8")
    print(f"wrote {out_path} ({len(md):,} chars)", file=sys.stderr)
    if args.also_print:
        print(md)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
