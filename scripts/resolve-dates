#!/usr/bin/env -S uv run --quiet python
"""Resolve suspect deed dates collected by scripts/scan-dates.

Reads the date_issues.yaml report and lets a curator set a corrected year_bce
(per event, or per cluster), patching events.date_json and writing an audit_log
row for every change. WRITES to the canonical DB — snapshots it first (WAL
checkpoint + .bak) per the project's WAL-safety rule.

Modes
-----
  scripts/resolve-dates --list                 print issues (high first); no writes
  scripts/resolve-dates                         interactive triage (high-severity first)
  scripts/resolve-dates --set EVENT_ID YEAR     non-interactive single fix
  scripts/resolve-dates --cluster chN YEAR      apply YEAR to every report event in cluster chN

For relative_to_prior_event clusters (e.g. the 共叔段 chain all dated 756), prefer
--cluster: fix the whole chain at once rather than row-by-row.
"""
from __future__ import annotations

import argparse
import json
import shutil
import sqlite3
from pathlib import Path

import yaml


def snapshot(db_path: Path) -> Path:
    """Checkpoint the WAL into the main file, then copy to a .bak (gitignored)."""
    with sqlite3.connect(db_path) as c:
        c.execute("PRAGMA wal_checkpoint(TRUNCATE);")
    bak = db_path.with_suffix(db_path.suffix + ".bak-datefix")
    shutil.copyfile(db_path, bak)
    return bak


def patch_year(
    conn: sqlite3.Connection,
    event_id: str,
    new_year: int,
    *,
    actor: str,
    reason: str,
    uncertainty: str | None = None,
    fill_method: str | None = None,
) -> str:
    """Set events.date_json.year_bce = new_year; mark curated; audit-log it.

    Optional `uncertainty` ('point'|'circa'|…) and `fill_method` (provenance of an
    interpolated date) are stamped into date_json so approximate fills stay honest.
    Returns 'set' | 'noop' | 'missing'. Pure DB op — no I/O, testable.
    """
    row = conn.execute("SELECT date_json FROM events WHERE id=?", (event_id,)).fetchone()
    if row is None:
        return "missing"
    d = json.loads(row[0]) if row[0] else {}
    before = d.get("year_bce")
    if before == new_year:
        return "noop"
    d["year_bce"] = new_year
    d["curated"] = True
    if uncertainty:
        d["uncertainty"] = uncertainty
    if fill_method:
        d["fill_method"] = fill_method
    conn.execute(
        "UPDATE events SET date_json=?, provenance='curated', updated_at=datetime('now') WHERE id=?",
        (json.dumps(d, ensure_ascii=False), event_id),
    )
    conn.execute(
        "INSERT OR REPLACE INTO audit_log "
        "(id, entity_kind, entity_id, field, change_kind, before_json, after_json, actor, at) "
        "VALUES (?,?,?,?,?,?,?,?,datetime('now'))",
        (
            f"aud:datefix:{event_id}:{before}->{new_year}",
            "event",
            event_id,
            "date_json.year_bce",
            "set",
            json.dumps({"year_bce": before}, ensure_ascii=False),
            json.dumps({"year_bce": new_year, "reason": reason}, ensure_ascii=False),
            actor,
        ),
    )
    return "set"


def load_issues(report: Path) -> list[dict]:
    r = yaml.safe_load(report.read_text("utf-8")) or {}
    return r.get("issues", [])


def event_summary(conn: sqlite3.Connection, eid: str) -> str:
    row = conn.execute("SELECT type, summary FROM events WHERE id=?", (eid,)).fetchone()
    if not row:
        return "(missing)"
    return f"[{row[0]}] {(row[1] or '')[:60]}"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--db", default="data/changjuan.sqlite")
    ap.add_argument("--report", default="data/date_issues.yaml")
    ap.add_argument("--list", action="store_true", help="print issues; no writes")
    ap.add_argument("--set", nargs=2, metavar=("EVENT_ID", "YEAR"), help="fix one event")
    ap.add_argument("--cluster", nargs=2, metavar=("CLUSTER", "YEAR"), help="fix all report events in a cluster")
    ap.add_argument("--apply-fills", metavar="FILE", help="batch-apply a propose-undated fills.yaml")
    ap.add_argument("--actor", default="curator")
    args = ap.parse_args()

    db_path = Path(args.db)
    issues = load_issues(Path(args.report))
    sev_rank = {"high": 0, "medium": 1, "low": 2}
    issues.sort(key=lambda i: (sev_rank.get(i.get("severity"), 3), -i.get("deviation", 0)))

    if args.list:
        for i in issues:
            print(f"  {i['severity']:6s} [{i['check']}] {i['event_id']:24s} y={i['year_bce']} :: {i['detail']}")
        print(f"\n{len(issues)} issues. Resolve with --set / --cluster or run with no flags for interactive.")
        return 0

    # writing path
    bak = snapshot(db_path)
    print(f"snapshot -> {bak}")
    conn = sqlite3.connect(db_path)
    changed = 0
    try:
        if args.apply_fills:
            doc = yaml.safe_load(Path(args.apply_fills).read_text("utf-8")) or {}
            for f in doc.get("fills", []):
                res = patch_year(
                    conn, f["event_id"], int(f["suggested_year"]),
                    actor=args.actor, reason=f"undated fill ({f.get('method')})",
                    uncertainty=f.get("uncertainty"), fill_method=f.get("method"),
                )
                changed += res == "set"
            print(f"  applied fills from {args.apply_fills}")
        elif args.set:
            eid, yr = args.set[0], int(args.set[1])
            res = patch_year(conn, eid, yr, actor=args.actor, reason="manual --set")
            print(f"  {res}: {eid} -> {yr}")
            changed += res == "set"
        elif args.cluster:
            cl, yr = args.cluster[0], int(args.cluster[1])
            targets = [i["event_id"] for i in issues if i.get("cluster") == cl]
            for eid in targets:
                res = patch_year(conn, eid, yr, actor=args.actor, reason=f"cluster {cl} --cluster")
                print(f"  {res}: {eid} -> {yr}")
                changed += res == "set"
        else:
            # interactive triage, high severity first
            for i in [x for x in issues if x["severity"] == "high"]:
                eid, cur = i["event_id"], i["year_bce"]
                print(f"\n{i['detail']}\n  {eid}  current year_bce={cur}\n  {event_summary(conn, eid)}")
                ans = input("  new year (int) / [c]<year> cluster / [s]kip / [q]uit: ").strip()
                if ans in ("", "s"):
                    continue
                if ans == "q":
                    break
                if ans.startswith("c"):
                    yr = int(ans[1:].strip())
                    for tid in [x["event_id"] for x in issues if x.get("cluster") == i.get("cluster")]:
                        if patch_year(conn, tid, yr, actor=args.actor, reason=f"cluster {i.get('cluster')}") == "set":
                            changed += 1
                else:
                    if patch_year(conn, eid, int(ans), actor=args.actor, reason="interactive") == "set":
                        changed += 1
        conn.commit()
    finally:
        conn.execute("PRAGMA wal_checkpoint(TRUNCATE);")
        conn.close()
    print(f"\n{changed} event date(s) corrected. Re-run scripts/scan-dates to refresh the report.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
