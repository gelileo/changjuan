# Project-local data — generated per-book artifacts are ignored; curated files
# (book-meta.json, prominence_overrides.yaml, shared data/reigns/) are tracked.
# Multi-book layout: per-book working files live under data/books/<book_id>/.
data/books/*/canonical.sqlite
data/books/*/corpus.sqlite
data/books/*/exports/
data/books/*/extractions/
data/books/*/logs/
data/books/*/qa/
data/books/*/readable/
data/books/*/canonical.sqlite.*-bak
data/books/*/*.bak-*
# legacy top-level (pre-multi-book) — kept so stale files stay ignored
data/changjuan.sqlite
data/corpus.sqlite
data/exports/
data/extractions/
data/logs/
data/qa/
data/readable/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Brainstorm / visual companion scratch (kept at workspace level)
.superpowers/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
.env.local
*.egg-info/
build/
dist/

# Streamlit
.streamlit/secrets.toml

# Editor / OS
.vscode/
.idea/
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.playwright-mcp
# local DB snapshots (never commit binary backups)
data/changjuan.sqlite.*-bak
data/changjuan.sqlite.bak-*

# generated date-audit report (scripts/scan-dates)
data/date_issues.yaml
data/undated_fills.yaml
